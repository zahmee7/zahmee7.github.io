---
// The closing card: the one action the brief asks for, opening the digital card (DESIGN.md > Closing card).
import Icon from "../ui/Icon.astro";
import { links } from "../../i18n/ui";
import { t, type Locale } from "../../i18n/utils";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = t(lang);
---

<footer class="container closing-wrap">
  <div class="closing">
    <p class="closing__line">{copy.footer.line}</p>
    <a class="btn btn--primary" href={links.card}>
      <span>{copy.footer.cardCta}</span>
      <Icon name="external" />
    </a>
    <p class="closing__note">{copy.footer.sample}</p>
  </div>
</footer>

<style>
  .closing-wrap {
    padding-block: clamp(64px, 8vw, 128px);
  }
  .closing {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
    padding: var(--s-7);
    border: 1px solid var(--c-line-2);
    border-radius: var(--r-drawer);
    background: var(--c-night-2);
  }
  .closing__line {
    margin: 0;
    color: var(--c-mist);
  }
  .closing__note {
    margin: 0;
    color: var(--c-mist-2);
    font-size: var(--fs-meta);
  }
  @media (max-width: 899px) {
    .closing {
      padding: var(--s-6) var(--s-5);
    }
    .closing :global(.btn) {
      white-space: normal;
      text-align: start;
      line-height: 1.3;
      padding-block: var(--s-2);
    }
  }
</style>
