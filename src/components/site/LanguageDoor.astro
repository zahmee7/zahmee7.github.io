---
// The site root once it is open to everyone (src/pages/index.astro): it sends visitors to /ar/ or /en/ from
// the browser language, with plain links as a fallback.
import "../../styles/tokens.css";
import { launched } from "../../i18n/ui";
import { t } from "../../i18n/utils";

const ar = t("ar");
const en = t("en");
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{ar.meta.title}</title>
    <meta name="description" content={ar.meta.description} />
    {!launched && <meta name="robots" content="noindex" />}
    <link rel="alternate" hreflang="ar" href="/ar/" />
    <link rel="alternate" hreflang="en" href="/en/" />
    <link rel="alternate" hreflang="x-default" href="/ar/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      (function () {
        var first = (navigator.languages && navigator.languages[0]) || navigator.language || "";
        location.replace(first.toLowerCase().indexOf("ar") === 0 ? "/ar/" : "/en/");
      })();
    </script>
  </head>
  <body>
    <main>
      <a href="/ar/" lang="ar" dir="rtl">
        {ar.name} · {ar.meta.title}
      </a>
      <a href="/en/" lang="en" dir="ltr">
        {en.name} · {en.meta.title}
      </a>
    </main>
  </body>
</html>

<style>
  body {
    margin: 0;
    min-block-size: 100dvh;
    display: grid;
    place-items: center;
    background: var(--c-night);
    color: var(--c-paper);
    font-family: system-ui, sans-serif;
  }
  main {
    display: grid;
    gap: var(--s-4);
    text-align: center;
  }
  a {
    display: inline-block;
    min-block-size: var(--tap);
    padding: var(--s-3) var(--s-5);
    color: inherit;
  }
</style>
