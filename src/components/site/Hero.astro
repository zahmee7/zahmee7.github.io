---
// Kicker, display H1 and lead (DESIGN.md > Page anatomy, Layout).
import { t, type Locale } from "../../i18n/utils";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = t(lang);
---

<section class="container hero" aria-labelledby="hero-title">
  <div class="hero__grid">
    <p class="kicker hero__kicker">{copy.hero.kicker}</p>
    <h1 class="hero__title" id="hero-title">
      {copy.hero.h1}
    </h1>
    <p class="hero__lead">{copy.hero.lead}</p>
  </div>
</section>

<style>
  /* Owner's choice (design A): the title and the lead side by side, so the drawer takes most of the
     first view */
  .hero {
    padding-block: var(--s-4);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: end;
    column-gap: clamp(16px, 2vw, 32px);
  }
  .hero__kicker {
    grid-column: 1 / -1;
  }
  .hero__title {
    grid-column: 1 / span 7;
    margin: 0;
    font: var(--fw-display) var(--fs-hero) / var(--lh-display) var(--font-display);
    letter-spacing: var(--ls-display);
    text-wrap: balance;
  }
  .hero__lead {
    grid-column: 8 / span 5;
    max-inline-size: 46ch;
    margin: 0;
    color: var(--c-mist);
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
    text-wrap: pretty;
  }

  /* First load, once per session (design/MOTION.md sequence 1) */
  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 var(--m-rise);
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
  :global(.is-entering) .hero__kicker,
  :global(.is-entering) .hero__title,
  :global(.is-entering) .hero__lead {
    animation: rise 700ms var(--ease-paper) backwards;
  }
  :global(.is-entering) .hero__title {
    animation-delay: 100ms;
  }
  :global(.is-entering) .hero__lead {
    animation-delay: 200ms;
  }

  /* Short desktop screens: a smaller title, so the drawer below keeps its room */
  @media (min-width: 900px) and (max-height: 820px) {
    .hero {
      padding-block: var(--s-2) var(--s-3);
    }
    .hero__title {
      font-size: clamp(2.25rem, 1.4rem + 2vw, 3.25rem);
    }
    .hero__lead {
      font-size: 1rem;
    }
  }

  @media (max-width: 899px) {
    .hero {
      padding-block: var(--s-4) var(--s-5);
    }
    .hero__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .hero__kicker,
    .hero__title,
    .hero__lead {
      grid-column: 1 / -1;
    }
    .hero__title {
      margin-block-end: var(--s-5);
      font-size: 2.25rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.is-entering) .hero__kicker,
    :global(.is-entering) .hero__title,
    :global(.is-entering) .hero__lead {
      animation: none;
    }
  }
</style>
