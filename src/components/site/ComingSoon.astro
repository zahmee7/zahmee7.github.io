---
// The site root while the owner keeps the site to himself (src/i18n/ui.ts → comingSoon; DESIGN.md > Page
// anatomy). The closed drawer, stamped "Coming soon", one short note in each language and the way to the
// digital card. The owner opens /?preview once in his browser to see the whole site; /?public undoes it.
import Base from "../../layouts/Base.astro";
import Stamp from "../ui/Stamp.astro";
import { links } from "../../i18n/ui";
import { t } from "../../i18n/utils";

const ar = t("ar");
const en = t("en");
// Before the first paint: the owner's preview switch, and his way on to the site in his own language
const door = `(function () {
  var search = location.search;
  try {
    if (/[?&]preview(=|&|$)/.test(search)) localStorage.setItem("preview", "1");
    if (/[?&]public(=|&|$)/.test(search)) localStorage.removeItem("preview");
    if (!localStorage.getItem("preview")) {
      if (search) history.replaceState(null, "", "/"); // a clean address to copy
      return;
    }
  } catch (error) {
    return;
  }
  document.documentElement.style.visibility = "hidden";
  var first = (navigator.languages && navigator.languages[0]) || navigator.language || "";
  location.replace(first.toLowerCase().indexOf("ar") === 0 ? "/ar/" : "/en/");
})();`;
---

<Base
  lang="ar"
  root
  noindex
  title={`${ar.soon.title.replace(/\.$/, "")} · ${ar.name}`}
  description={ar.soon.description}
>
  <script is:inline slot="head" set:html={door} />
  <main class="container soon">
    <header class="soon__byline">
      <p class="soon__name">{ar.name}</p>
      <p class="soon__name" lang="en" dir="ltr">
        {en.name}
      </p>
    </header>

    <div class="soon__front" aria-hidden="true">
      <span class="soon__label">{ar.drawer.label}</span>
      <span class="soon__pull"></span>
      <Stamp text={ar.drawer.locked} decorative class="soon__stamp" />
    </div>

    <div class="soon__words">
      <section class="soon__block" lang="ar" dir="rtl">
        <p class="kicker">{ar.hero.kicker}</p>
        <h1 class="soon__title">{ar.soon.title}</h1>
        <p class="soon__lead">{ar.soon.lead}</p>
        <a class="btn btn--primary" href={links.card}>
          {ar.nav.card}
        </a>
      </section>
      <section class="soon__block" lang="en" dir="ltr">
        <p class="kicker">{en.hero.kicker}</p>
        <p class="soon__title">{en.soon.title}</p>
        <p class="soon__lead">{en.soon.lead}</p>
        <a class="btn" href={links.card}>
          {en.nav.card}
        </a>
      </section>
    </div>
  </main>
</Base>

<style>
  .soon {
    min-block-size: 100svh;
    display: grid;
    align-content: center;
    gap: var(--s-7);
    padding-block: var(--s-7);
  }
  .soon__byline {
    display: flex;
    justify-content: space-between;
    gap: var(--s-4);
  }
  .soon__name {
    margin: 0;
    font: var(--fw-display) 1.125rem / 1.3 var(--font-display);
  }

  /* The drawer front, closed, as on the home page (Cabinet.astro): a bevelled edge, the label in a metal
     holder, a metal pull. The stamp lands on it once. */
  .soon__front {
    position: relative;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--s-4);
    min-block-size: 168px;
    border-radius: 8px;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--c-drawer-edge), white 14%) 0,
      var(--c-drawer-edge) 3px,
      var(--c-drawer) 16px,
      color-mix(in srgb, var(--c-drawer), black 28%) 100%
    );
    box-shadow:
      var(--sh-drawer),
      inset 0 -8px 16px rgb(0 0 0 / 0.35);
  }
  .soon__label {
    padding: 10px 28px;
    border-radius: 3px;
    background: var(--c-paper);
    color: var(--c-ink);
    font: var(--fw-ui) 0.9375rem / 1.4 var(--font-ui);
    box-shadow:
      0 0 0 5px color-mix(in srgb, var(--c-mist), var(--c-drawer) 35%),
      0 0 0 6px rgb(0 0 0 / 0.45),
      0 3px 8px 6px rgb(0 0 0 / 0.35),
      inset 0 1px 3px rgb(var(--c-ink-rgb) / 0.2);
  }
  .soon__pull {
    inline-size: 170px;
    block-size: 18px;
    border-radius: var(--r-pill);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--c-mist), white 30%),
      var(--c-mist-2) 55%,
      color-mix(in srgb, var(--c-mist-2), black 35%)
    );
    box-shadow:
      0 5px 10px rgb(0 0 0 / 0.55),
      inset 0 1px 0 rgb(255 255 255 / 0.7);
  }
  /* The stamp lands on the label's corner and leaves its words clear, larger than on a folder, in the paper's ink red. .soon gives
     this rule more weight than the stamp's own Arabic size (Stamp.astro). */
  .soon .soon__front :global(.soon__stamp) {
    position: absolute;
    inset-block-start: 10px;
    inset-inline-start: calc(50% + 52px);
    padding: 6px 20px;
    border-width: 2px;
    background: rgb(var(--c-paper-rgb) / 0.94);
    font-size: 1.375rem;
    mix-blend-mode: normal;
  }
  @keyframes stamp-press {
    from {
      opacity: 0;
      scale: 1.12;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .soon .soon__front :global(.soon__stamp) {
      animation: stamp-press var(--d-stamp) var(--ease-settle) 500ms backwards;
    }
  }

  .soon__words {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-8);
    align-items: start;
  }
  .soon__block {
    display: grid;
    justify-items: start;
    gap: var(--s-4);
  }
  .soon__block .kicker {
    margin: 0;
  }
  /* The page is Arabic at its root, so the English block takes back its own type settings */
  .soon__block[lang="en"] {
    --lh-display: 1.02;
    --lh-lead: 1.6;
    --ls-kicker: 0.26em;
    --fs-kicker: 0.8125rem;
  }
  .soon__block[lang="en"] .kicker {
    text-transform: uppercase;
  }
  .soon__title {
    margin: 0;
    font: var(--fw-display) var(--fs-hero) / var(--lh-display) var(--font-display);
  }
  .soon__lead {
    margin: 0;
    max-inline-size: 46ch;
    color: var(--c-mist);
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
    text-wrap: pretty;
  }

  @media (max-width: 899px) {
    .soon {
      align-content: start;
      gap: var(--s-6);
      padding-block: var(--s-5) var(--s-7);
    }
    .soon__front {
      min-block-size: 132px;
      margin-inline: calc(var(--gutter) * -1 + 6px);
      border-radius: 8px;
    }
    .soon .soon__front :global(.soon__stamp) {
      inset-block-start: 6px;
      inset-inline-start: calc(50% + 46px);
      font-size: 1.125rem;
    }
    .soon__pull {
      inline-size: 140px;
      block-size: 16px;
    }
    .soon__words {
      grid-template-columns: 1fr;
      gap: var(--s-7);
    }
  }
</style>
