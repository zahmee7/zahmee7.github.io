---
// Name and role as a byline, the digital card link and the language switch (DESIGN.md > Masthead).
import LangSwitch from "../ui/LangSwitch.astro";
import SoundSwitch from "../ui/SoundSwitch.astro";
import { links } from "../../i18n/ui";
import { t, type Locale } from "../../i18n/utils";

interface Props {
  lang: Locale;
  path?: string;
  /** The home page adds the switch for the drawer's sounds (wide screens; phones have it by the title). */
  sound?: boolean;
}

const { lang, path = "", sound = false } = Astro.props;
const copy = t(lang);
---

<header class="container masthead">
  <div class="byline">
    <p class="byline__name">{copy.name}</p>
    <p class="byline__role">{copy.role}</p>
  </div>
  <nav class="masthead__nav" aria-label={copy.name}>
    <a class="btn" href={links.card}>
      {copy.nav.card}
    </a>
    <LangSwitch lang={lang} path={path} />
    {sound && <SoundSwitch lang={lang} place="masthead" />}
  </nav>
</header>

<style>
  .masthead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding-block: var(--s-5);
  }
  @media (min-width: 900px) and (max-height: 820px) {
    .masthead {
      padding-block: var(--s-3);
    }
  }
  .byline__name {
    margin: 0;
    font: var(--fw-display) 1.125rem / 1.3 var(--font-display);
  }
  .byline__role {
    margin: 0;
    color: var(--c-mist-2);
    font-size: var(--fs-meta);
  }
  .masthead__nav {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }
  @media (max-width: 899px) {
    .masthead__nav :global(.btn) {
      padding-inline: var(--s-4);
    }
  }
  @media (max-width: 389px) {
    .byline__role {
      display: none;
    }
  }
</style>
