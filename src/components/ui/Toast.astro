---
// One live region for short messages. Show it with showToast() from ./toast.ts.
---

<div class="toast" id="toast" role="status" aria-live="polite"></div>

<style>
  .toast {
    position: fixed;
    z-index: var(--z-toast);
    inset-inline: 0;
    inset-block-end: calc(24px + env(safe-area-inset-bottom));
    inline-size: fit-content;
    max-inline-size: min(92vw, 420px);
    margin-inline: auto;
    padding: var(--s-3) var(--s-4);
    border: 1px solid var(--c-line-2);
    border-radius: var(--r-btn);
    background: var(--c-night-2);
    color: var(--c-paper);
    font-size: var(--fs-meta);
    opacity: 0;
    translate: 0 12px;
    pointer-events: none;
    transition:
      opacity 250ms var(--ease-paper),
      translate 250ms var(--ease-paper);
  }
  .toast:global(.is-on) {
    opacity: 1;
    translate: 0 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .toast {
      translate: none;
      transition: opacity var(--d-fade) linear;
    }
  }
</style>
