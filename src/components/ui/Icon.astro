---
// Inline SVG icons: 20 px grid, 1.5 px stroke, round caps, currentColor (DESIGN.md > Icons and imagery).
const paths = {
  arrow:
    '<path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>',
  close:
    '<path d="M5 5l10 10M15 5 5 15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>',
  download:
    '<path d="M10 3v10M5.5 8.5 10 13l4.5-4.5M4 16.5h12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>',
  external:
    '<path d="M8 4H4.5v11.5H16V12M11 4h5v5M16 4l-7 7" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>',
  lock: '<path d="M6.5 9V6.5a3.5 3.5 0 0 1 7 0V9M5 9h10v7.5H5z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>',
  play: '<path d="M7 4.5v11l9-5.5z" fill="currentColor"/>',
} as const;

interface Props {
  name: keyof typeof paths;
  /** Mirror in RTL (for arrows that point along the reading direction). */
  directional?: boolean;
  class?: string;
}

const { name, directional = false, class: className } = Astro.props;
---

<svg
  class:list={["icon", { "icon--dir": directional }, className]}
  viewBox="0 0 20 20"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>
