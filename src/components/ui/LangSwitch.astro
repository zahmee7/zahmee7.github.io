---
// Link to the same page in the other language.
import { otherLocale, t, type Locale } from "../../i18n/utils";

interface Props {
  lang: Locale;
  /** Path after the locale, e.g. "projects/ndi-readiness/". Empty for the home page. */
  path?: string;
}

const { lang, path = "" } = Astro.props;
const other = otherLocale(lang);
const copy = t(lang);
---

<a
  class="btn lang-switch"
  href={`/${other}/${path}`}
  hreflang={other}
  lang={other}
  aria-label={copy.nav.langLabel}
>
  {copy.nav.langShort}
</a>
