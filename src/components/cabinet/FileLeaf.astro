---
// The inside of one project's file: two columns like the two pages of an open file (DESIGN.md > Open file).
// Used in the home page's closed templates (FileSheet.astro) and, in Phase 4, on the project page.
// Parts not built yet (film, demo, full page, download) carry data-soon: a click shows "Coming soon".
import type { CollectionEntry } from "astro:content";
import Icon from "../ui/Icon.astro";
import { t, type Locale } from "../../i18n/utils";

interface Props {
  project: CollectionEntry<"projects">["data"];
  lang: Locale;
}

const { project, lang } = Astro.props;
const copy = t(lang);
const text = project[lang];
const download = project.downloads[0];
const storyParts = ["context", "did", "result"] as const;
const tiles = Array.from({ length: 14 }, (_, index) => (index % 7) + Math.floor(index / 7));
---

<div class="container leaf__body">
  <div class="leaf__col leaf__col--a">
    <p class="file__tag" data-rise>
      {text.tag}
    </p>
    <h2 class="file__title" id={`file-title-${project.id}`} tabindex="-1" data-rise>
      {text.title}
    </h2>
    <div class="film" data-rise>
      <div class="film__tiles" aria-hidden="true">
        {tiles.map((delay) => (
          <i class="film__tile" style={`--t: ${delay};`} />
        ))}
      </div>
      <button class="film__play" type="button" aria-label={copy.file.playFilm} data-soon>
        <Icon name="play" />
      </button>
    </div>
    <p class="film__summary" data-rise>
      <a class="link" href={`/${lang}/projects/${project.id}/`} data-soon>
        {copy.file.transcript}
      </a>
    </p>
  </div>

  <div class="leaf__col leaf__col--b">
    <div class="story">
      {storyParts.map((part, index) => (
        <section class="story__block" data-rise>
          <h3 class="story__label">{copy.file.story[index]}</h3>
          <p class="story__text">{text[part]}</p>
        </section>
      ))}
    </div>
    <div class="file__actions" data-rise>
      <a class="btn btn--primary" href={`/${lang}/demos/${project.id}/`} data-soon>
        <span>{text.demoLabel}</span>
        <Icon name="arrow" directional />
      </a>
      <a class="btn" href={`/${lang}/projects/${project.id}/`} data-soon>
        {copy.file.openFull}
      </a>
    </div>
    {download && (
      <a class="download" href={download.file} data-soon data-rise>
        <Icon name="download" class="download__icon" />
        <span class="download__label">{text.downloadLabel}</span>
        <span class="download__kind" lang="en">
          {download.kind.toUpperCase()}
        </span>
      </a>
    )}
  </div>
</div>

<style>
  .leaf__body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding-block: clamp(32px, 5vw, 72px);
  }
  .leaf__col--a {
    position: sticky;
    inset-block-start: 104px;
    align-self: start;
    padding-inline-end: clamp(32px, 4vw, 72px);
  }
  .leaf__col--b {
    padding-inline-start: clamp(32px, 4vw, 72px);
    border-inline-start: 1px solid var(--c-paper-line);
  }

  .file__tag {
    margin: 0 0 var(--s-3);
    color: var(--c-teal);
    font: var(--fw-ui) var(--fs-kicker) / 1.4 var(--font-ui);
    letter-spacing: var(--ls-kicker);
    text-transform: uppercase;
  }
  :global(:root:lang(ar)) .file__tag {
    text-transform: none;
  }
  .file__title {
    max-inline-size: 14ch;
    margin: 0 0 var(--s-6);
    font: var(--fw-display) clamp(2.25rem, 1.4rem + 3vw, 4rem) / var(--lh-title) var(--font-display);
    letter-spacing: var(--ls-title);
    text-wrap: balance;
  }
  .file__title:focus {
    outline: none; /* receives focus by script after opening */
  }
  .file__title:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 4px;
  }

  /* Film frame: tile placeholder until the films arrive (Phase 5) */
  .film {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: var(--c-film);
  }
  .film__tiles {
    position: absolute;
    inset: 14%;
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 8px;
  }
  .film__tile {
    border-radius: 4px;
    background: var(--c-film-tile);
  }
  @keyframes tile {
    0%,
    100% {
      background: var(--c-film-tile);
    }
    40% {
      background: var(--c-film-lit);
    }
    60% {
      background: var(--c-film-tile);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(dialog[open]) .film__tile {
      animation: tile 4.2s ease-in-out infinite;
      animation-delay: calc(var(--t) * 0.3s);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .film__tile:nth-child(3n) {
      background: var(--c-film-lit);
    }
  }
  .film__play {
    position: relative;
    display: grid;
    place-items: center;
    inline-size: 64px;
    block-size: 64px;
    border: 0;
    border-radius: 50%;
    background: var(--c-paper);
    color: var(--c-ink);
    cursor: pointer;
    transition:
      scale var(--d-press) var(--ease-paper),
      background-color 200ms var(--ease-paper);
  }
  .film__play :global(svg) {
    inline-size: 22px;
    block-size: 22px;
  }
  .film__play:active {
    scale: 0.96;
  }
  .film__play:focus-visible {
    outline: 3px solid var(--c-signal);
    outline-offset: 3px;
  }
  @media (hover: hover) {
    .film__play:hover {
      background: var(--c-paper-hi);
    }
  }
  .film__summary {
    margin: var(--s-3) 0 0;
    color: var(--c-ink-muted);
    font-size: var(--fs-meta);
  }

  .story {
    display: grid;
    gap: var(--s-6);
  }
  .story__block {
    padding-block-start: var(--s-4);
    border-block-start: 1px solid var(--c-paper-line);
  }
  .story__block:first-child {
    padding-block-start: 0;
    border-block-start: 0;
  }
  .story__label {
    margin: 0 0 var(--s-2);
    color: var(--c-ink-muted);
    font: var(--fw-ui) var(--fs-kicker) / 1.4 var(--font-ui);
    letter-spacing: var(--ls-kicker);
    text-transform: uppercase;
  }
  :global(:root:lang(ar)) .story__label {
    text-transform: none;
  }
  .story__text {
    max-inline-size: 34em;
    margin: 0;
    color: var(--c-ink-2);
    font: var(--fw-text) var(--fs-story) / var(--lh-story) var(--font-text);
    text-wrap: pretty;
  }

  .file__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-block-start: var(--s-7);
  }
  .download {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    min-block-size: var(--tap);
    margin-block-start: var(--s-4);
    padding-block: var(--s-2);
    border-block-end: 1px solid var(--c-paper-line);
    color: var(--c-ink);
    text-decoration: none;
  }
  .download :global(.download__icon) {
    transition: translate 200ms var(--ease-paper);
  }
  .download__kind {
    margin-inline-start: auto;
    color: var(--c-ink-muted);
    font-size: var(--fs-meta);
    letter-spacing: 0.08em;
  }
  @media (hover: hover) {
    .download:hover :global(.download__icon) {
      translate: 0 3px;
    }
    .download:hover .download__label {
      text-decoration: underline;
      text-underline-offset: 0.25em;
    }
  }

  @media (max-width: 899px) {
    .leaf__body {
      grid-template-columns: 1fr;
      padding-block: var(--s-5) var(--s-6);
    }
    .leaf__col--a {
      position: static;
      padding-inline-end: 0;
    }
    .leaf__col--b {
      margin-block-start: var(--s-6);
      padding-inline-start: 0;
      padding-block-start: var(--s-5);
      border-inline-start: 0;
      border-block-start: 1px solid var(--c-paper-line);
    }
    .file__actions :global(.btn) {
      white-space: normal;
      line-height: 1.3;
      padding-block: var(--s-2);
    }
  }
</style>
