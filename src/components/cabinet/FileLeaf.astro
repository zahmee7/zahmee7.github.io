---
// The inside of one project's file (DESIGN.md > Open file), in pages that turn in place (owner's request,
// 2026-10-24), as previous and next do between files: the page's blocks fade, the next page's rise in.
// - Page one: the tag, title and summary beside the film, then the story across the page in three columns;
//   right under the summary, the turn to page two.
// - Page two: the demo as a large card, and the files to download.
// - Page three: the demo itself, live, on the same paper under the same bar, as wide as the screen allows,
//   with the way out to Power BI. Its card on page two links to the demo page too, for a browser without
//   scripts.
// Phones: one column each. pages.ts turns the pages; the others stay hidden.
// In the DOM the story comes before the turn, so it is read first; the grid places them.
// Used in the home page's closed templates (FileSheet.astro) and on the project page.
// Parts not ready yet (a demo without its file, downloads, a film without its files) carry data-soon: a
// click shows "Coming soon".
// --rise orders page one's blocks for the project page's entrance (global.css), and every page's blocks
// for the turn; the dialog animates page one's with GSAP when it opens.
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Film from "../film/Film.astro";
import LiveFile from "../demos/LiveFile.astro";
import Icon from "../ui/Icon.astro";
import Stamp from "../ui/Stamp.astro";
import { t, type Locale } from "../../i18n/utils";

interface Props {
  project: CollectionEntry<"projects">["data"];
  lang: Locale;
  /** The project page makes the title its h1; in the home page's dialog it is an h2. */
  heading?: "h1" | "h2";
}

// Report snapshots drawn by npm run boards
const snapshots = import.meta.glob<{ default: ImageMetadata }>("/src/assets/boards/*.png", { eager: true });

const { project, lang, heading = "h2" } = Astro.props;
const Title = heading;
const Label = heading === "h1" ? "h2" : "h3";
const Sub = heading === "h1" ? "h3" : "h4";
const copy = t(lang);
const text = project[lang];
const storyParts = ["context", "did", "result"] as const;
const { demo } = project;
const live = demo.status === "ready" && demo.kind && demo.url;
const reportUrl = typeof demo.url === "string" ? demo.url : demo.url?.[lang];
const poster = live ? snapshots[`/src/assets/boards/${project.id}.png`]?.default : undefined;
const kindName = demo.kind ? copy.demo.kinds[demo.kind] : undefined;
const id = `file-${project.id}`;
---

<div class="file__pages" data-pages>
  <div class="file__page" data-page="1" id={`${id}-1`}>
    <div class="container leaf__body">
      <div class="file__head">
        {text.tag && (
          <p class="file__tag" data-rise style="--rise: 0;">
            {text.tag}
          </p>
        )}
        <Title class="file__title" id={`file-title-${project.id}`} tabindex="-1" data-rise style="--rise: 1;">
          {text.title}
        </Title>
        <p class="file__lead" data-rise style="--rise: 2;">
          {text.summary}
        </p>
      </div>

      <div class="file__film" data-rise style="--rise: 3;">
        <Film project={project} lang={lang} />
      </div>

      <div class="story">
        {storyParts.map((part, index) => (
          <section class="story__block" data-rise style={`--rise: ${5 + index};`}>
            <Label class="story__label">{copy.file.story[index]}</Label>
            <p class="story__text">{text[part]}</p>
          </section>
        ))}
      </div>

      <div class="file__act" data-rise style="--rise: 4;">
        <button class="btn btn--primary file__turn" type="button" data-page-to="2" aria-controls={`${id}-2`}>
          <span>{copy.file.turn}</span>
          <Icon name="arrow" directional />
        </button>
      </div>
    </div>
  </div>

  <div class="file__page" data-page="2" id={`${id}-2`} hidden>
    <div class="container two">
      <header class="two__head" data-turn-rise style="--rise: 0;">
        <p class="file__tag">{text.title}</p>
        <Label class="two__title" tabindex="-1" data-page-title>
          {copy.file.pageTwo}
        </Label>
      </header>

      <a
        class="two__demo"
        href={`/${lang}/demos/${project.id}/`}
        data-soon={live ? undefined : ""}
        data-page-to={live ? "3" : undefined}
        aria-controls={live ? `${id}-3` : undefined}
        data-turn-rise
        style="--rise: 1;"
      >
        <span class="two__shot">
          {poster ? (
            <Picture
              class="two__img"
              src={poster}
              alt={copy.demo.snapshot}
              widths={[800, 1200, 1600]}
              sizes="(min-width: 1440px) 760px, 60vw"
              formats={["avif", "webp"]}
            />
          ) : (
            <span class="two__blank" aria-hidden="true" />
          )}
        </span>
        <span class="two__words">
          {kindName && <span class="two__kind">{kindName}</span>}
          <span class="two__name">{text.demoLabel}</span>
          <span class="two__note">{live ? copy.demo.inSite : copy.drawer.locked}</span>
          <Icon name="arrow" directional class="two__go" />
        </span>
        {poster && <Stamp text={copy.demo.badge} decorative class="two__stamp" />}
      </a>

      <section class="two__files" aria-labelledby={`${id}-files`} data-turn-rise style="--rise: 2;">
        <Sub class="story__label" id={`${id}-files`}>
          {copy.file.downloads}
        </Sub>
        {project.downloads.map((download) => (
          <a class="download" href={download.file} data-soon>
            <Icon name="download" class="download__icon" />
            <span class="download__label">{text.downloadLabel}</span>
            <span class="download__kind" lang="en">
              {download.kind.toUpperCase()}
            </span>
          </a>
        ))}
      </section>

      <div class="two__back" data-turn-rise style="--rise: 3;">
        <button class="btn" type="button" data-page-to="1" aria-controls={`${id}-1`}>
          <Icon name="arrow" class="file__back-icon" />
          <span>{copy.file.turnBack}</span>
        </button>
      </div>
    </div>
  </div>

  {live && reportUrl && demo.kind && (
    <div class="file__page" data-page="3" id={`${id}-3`} hidden>
      <div class="container three">
        <header class="three__head" data-turn-rise style="--rise: 0;">
          <div>
            <p class="file__tag">{text.title}</p>
            <Label class="three__title" tabindex="-1" data-page-title>
              {copy.demo.title}
            </Label>
          </div>
          <div class="three__tools">
            <Stamp text={copy.demo.badge} class="three__stamp" />
            <button class="btn" type="button" data-page-to="2" aria-controls={`${id}-2`}>
              <Icon name="arrow" class="file__back-icon" />
              <span>{copy.file.turnBackTwo}</span>
            </button>
          </div>
        </header>
        <div class="three__board" data-turn-rise style="--rise: 1;">
          <LiveFile
            lang={lang}
            kind={demo.kind}
            url={reportUrl}
            page={demo.page}
            title={`${text.title} · ${kindName}`}
            poster={poster}
          />
        </div>
      </div>
    </div>
  )}
</div>

<style>
  .leaf__body {
    display: grid;
    grid-template-columns: 5fr 7fr;
    grid-template-rows: auto 1fr auto;
    grid-template-areas:
      "head film"
      "act film"
      "story story";
    column-gap: clamp(40px, 5vw, 88px);
    padding-block: clamp(40px, 4.5vw, 64px) clamp(40px, 4vw, 64px);
  }
  .file__head {
    grid-area: head;
  }
  .file__film {
    grid-area: film;
  }
  /* The turn to page two sits right under the summary, not down at the film's foot (owner, 2026-10-25) */
  .file__act {
    grid-area: act;
    align-self: start;
    padding-block-start: var(--s-6);
  }

  /* Page two (owner's request, 2026-10-24): the demo as a large card, the files beside it */
  .two {
    display: grid;
    grid-template-columns: 8fr 4fr;
    grid-template-areas:
      "head head"
      "demo files"
      "back back";
    column-gap: clamp(32px, 4vw, 72px);
    padding-block: clamp(40px, 4.5vw, 64px) clamp(48px, 5vw, 80px);
    min-block-size: calc(100dvh - 72px);
    align-content: start;
  }
  .two__head {
    grid-area: head;
    margin-block-end: var(--s-6);
  }
  .two__title {
    margin: 0;
    font: var(--fw-display) var(--fs-title) / var(--lh-title) var(--font-display);
  }
  .two__title:focus {
    outline: none; /* receives focus when the page turns */
  }
  /* The demo card: the report's snapshot, then what it is and where it goes */
  .two__demo {
    grid-area: demo;
    position: relative;
    display: grid;
    grid-template-rows: auto auto;
    border: 1px solid var(--c-paper-line);
    border-radius: 14px;
    background: var(--c-paper-hi);
    color: var(--c-ink);
    text-decoration: none;
    box-shadow: 0 22px 48px -30px rgb(var(--c-ink-rgb) / 0.55);
    transition:
      translate 300ms var(--ease-paper),
      box-shadow 300ms var(--ease-paper);
  }
  .two__shot {
    display: block;
    overflow: hidden;
    border-radius: 13px 13px 0 0;
    aspect-ratio: 16 / 9;
    background: var(--c-night-2);
  }
  .two__shot :global(.two__img) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }
  .two__blank {
    display: block;
    block-size: 100%;
    background:
      repeating-linear-gradient(0deg, transparent 0 31px, rgb(var(--c-paper-rgb) / 0.06) 31px 32px),
      var(--c-night-2);
  }
  .two__words {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 2px var(--s-4);
    padding: var(--s-5) var(--s-6);
  }
  .two__kind {
    grid-column: 1;
    color: var(--c-teal);
    font-size: var(--fs-meta);
  }
  .two__name {
    grid-column: 1;
    font: var(--fw-display) 1.5rem / 1.3 var(--font-display);
  }
  .two__note {
    grid-column: 1;
    color: var(--c-ink-muted);
    font-size: var(--fs-meta);
  }
  .two__words :global(.two__go) {
    grid-column: 2;
    grid-row: 1 / span 3;
    inline-size: 28px;
    block-size: 28px;
    transition: translate 300ms var(--ease-paper);
  }
  .two__demo :global(.two__stamp) {
    mix-blend-mode: normal; /* the ink would vanish into the report's dark header */
    position: absolute;
    inset-block-start: -14px;
    inset-inline-end: var(--s-5);
    background: var(--c-paper);
  }
  @media (hover: hover) {
    .two__demo:not([data-soon]):hover {
      translate: 0 -4px;
      box-shadow: 0 30px 60px -30px rgb(var(--c-ink-rgb) / 0.6);
    }
    .two__demo:not([data-soon]):hover :global(.two__go) {
      translate: -6px 0;
    }
    :global([dir="ltr"]) .two__demo:not([data-soon]):hover :global(.two__go) {
      translate: 6px 0;
    }
  }
  .two__demo:focus-visible {
    outline: 3px solid var(--c-teal);
    outline-offset: 4px;
  }
  .two__files {
    grid-area: files;
    align-self: start;
  }
  .two__back {
    grid-area: back;
    margin-block-start: var(--s-7);
  }
  /* the arrow points back, towards the start of the line: right in Arabic, left in English */
  :global([dir="ltr"]) :global(.file__back-icon) {
    scale: -1 1;
  }

  /* Page three: the demo itself, live, as wide as the screen allows under the bar (owner's request,
     2026-10-24), numbers at full size; never taller than the screen */
  .three {
    --container: 1680px;
    --gutter: clamp(16px, 2.5vw, 40px);
    padding-block: var(--s-5) var(--s-7);
  }
  .three__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--s-3) var(--s-5);
    margin-block-end: var(--s-4);
  }
  .three__title {
    margin: 0;
    font: var(--fw-display) clamp(1.5rem, 1.1rem + 1vw, 2rem) / var(--lh-title) var(--font-display);
  }
  .three__title:focus {
    outline: none; /* receives focus when the page turns */
  }
  .three__tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-5);
  }
  .three__board {
    max-inline-size: calc((100dvh - 72px - 205px) * 16 / 9); /* the bar, the header, Power BI's own bar */
    margin-inline: auto;
  }
  /* A phone, upright or sideways: the board takes the full width and the page scrolls; held sideways, that
     is the largest the numbers can be (2026-10-26) */
  @media (max-width: 899px), (max-height: 520px) {
    .three__board {
      max-inline-size: none;
    }
  }

  .file__tag {
    margin: 0 0 var(--s-3);
    color: var(--c-teal);
    font: var(--fw-ui) var(--fs-kicker) / 1.4 var(--font-ui);
    letter-spacing: var(--ls-kicker);
    text-transform: uppercase;
  }
  :global(:root:lang(ar)) .file__tag {
    text-transform: none;
  }
  .file__title {
    max-inline-size: 14ch;
    margin: 0 0 var(--s-5);
    font: var(--fw-display) clamp(2.25rem, 1.4rem + 3vw, 4rem) / var(--lh-title) var(--font-display);
    letter-spacing: var(--ls-title);
    text-wrap: balance;
  }
  .file__title:focus {
    outline: none; /* receives focus by script after opening */
  }
  .file__title:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 4px;
  }

  .file__lead {
    max-inline-size: 30em;
    margin: 0;
    color: var(--c-ink-2);
    font: var(--fw-ui) var(--fs-lead) / 1.6 var(--font-ui);
    text-wrap: pretty;
  }

  /* The story across the page: three columns under an ink rule, split by hairlines */
  .story {
    grid-area: story;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-block-start: clamp(64px, 6vw, 96px);
    border-block-start: 1px solid var(--c-ink);
  }
  .story__block {
    padding: var(--s-6) clamp(24px, 2.5vw, 44px) 0;
    border-inline-start: 1px solid var(--c-paper-line);
  }
  .story__block:first-child {
    padding-inline-start: 0;
    border-inline-start: 0;
  }
  .story__block:last-child {
    padding-inline-end: 0;
  }
  .story__label {
    margin: 0 0 var(--s-3);
    color: var(--c-ink-muted);
    font: var(--fw-ui) var(--fs-ui) / 1.4 var(--font-ui);
    letter-spacing: var(--ls-kicker);
    text-transform: uppercase;
  }
  :global(:root:lang(ar)) .story__label {
    text-transform: none;
  }
  .story__text {
    max-inline-size: 34em;
    margin: 0;
    color: var(--c-ink-2);
    font: var(--fw-text) var(--fs-story) / var(--lh-story) var(--font-text);
    text-wrap: pretty;
  }

  .file__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }
  .download {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    min-block-size: var(--tap);
    margin-block-start: var(--s-4);
    padding-block: var(--s-2);
    border-block-end: 1px solid var(--c-paper-line);
    color: var(--c-ink);
    text-decoration: none;
  }
  .download :global(.download__icon) {
    transition: translate 200ms var(--ease-paper);
  }
  .download__kind {
    margin-inline-start: auto;
    color: var(--c-ink-muted);
    font-size: var(--fs-meta);
    letter-spacing: 0.08em;
  }
  @media (hover: hover) {
    .download:hover :global(.download__icon) {
      translate: 0 3px;
    }
    .download:hover .download__label {
      text-decoration: underline;
      text-underline-offset: 0.25em;
    }
  }

  @media (max-width: 899px) {
    .leaf__body {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      grid-template-areas: "head" "film" "story" "act";
      padding-block: var(--s-5) var(--s-6);
    }
    .file__film {
      margin-block-start: var(--s-5);
    }
    .story {
      grid-template-columns: 1fr;
      margin-block-start: var(--s-6);
    }
    .story__block {
      padding: var(--s-5) 0 var(--s-2);
      border-inline-start: 0;
      border-block-start: 1px solid var(--c-paper-line);
    }
    .story__block:first-child {
      border-block-start: 0;
    }
    .file__act {
      padding-block-start: var(--s-5);
    }
    .two {
      grid-template-columns: 1fr;
      grid-template-areas: "head" "demo" "files" "back";
      row-gap: var(--s-6);
      padding-block: var(--s-5) var(--s-6);
    }
    .two__head {
      margin-block-end: 0;
    }
    .two__words {
      padding: var(--s-4);
    }
    .two__name {
      font-size: 1.25rem;
    }
    .file__actions :global(.btn) {
      white-space: normal;
      line-height: 1.3;
      padding-block: var(--s-2);
    }
  }
</style>
