---
// The inside of one project's file (DESIGN.md > Open file). Desktop: the tag, title and summary beside the
// film, the demo and download under them, then the story across the page in three columns. Phones: one column.
// In the DOM the story comes before the actions, so it is read first; the grid places them.
// Used in the home page's closed templates (FileSheet.astro) and on the project page.
// Parts not built yet (film, demo, download) carry data-soon: a click shows "Coming soon".
// --rise orders the blocks for the project page's entrance (global.css); the dialog animates them with GSAP.
import type { CollectionEntry } from "astro:content";
import Icon from "../ui/Icon.astro";
import { t, type Locale } from "../../i18n/utils";

interface Props {
  project: CollectionEntry<"projects">["data"];
  lang: Locale;
  /** The project page makes the title its h1; in the home page's dialog it is an h2. */
  heading?: "h1" | "h2";
}

const { project, lang, heading = "h2" } = Astro.props;
const Title = heading;
const Label = heading === "h1" ? "h2" : "h3";
const copy = t(lang);
const text = project[lang];
const download = project.downloads[0];
const storyParts = ["context", "did", "result"] as const;
const tiles = Array.from({ length: 14 }, (_, index) => (index % 7) + Math.floor(index / 7));
---

<div class="container leaf__body">
  <div class="file__head">
    <p class="file__tag" data-rise style="--rise: 0;">
      {text.tag}
    </p>
    <Title class="file__title" id={`file-title-${project.id}`} tabindex="-1" data-rise style="--rise: 1;">
      {text.title}
    </Title>
    <p class="file__lead" data-rise style="--rise: 2;">
      {text.summary}
    </p>
  </div>

  <div class="file__film" data-rise style="--rise: 3;">
    <div class="film">
      <div class="film__tiles" aria-hidden="true">
        {tiles.map((delay) => (
          <i class="film__tile" style={`--t: ${delay};`} />
        ))}
      </div>
      <button class="film__play" type="button" aria-label={copy.file.playFilm} data-soon>
        <Icon name="play" />
      </button>
    </div>
    <p class="film__summary">
      <a class="link" href={`/${lang}/projects/${project.id}/`} data-soon>
        {copy.file.transcript}
      </a>
    </p>
  </div>

  <div class="story">
    {storyParts.map((part, index) => (
      <section class="story__block" data-rise style={`--rise: ${5 + index};`}>
        <Label class="story__label">{copy.file.story[index]}</Label>
        <p class="story__text">{text[part]}</p>
      </section>
    ))}
  </div>

  <div class="file__act" data-rise style="--rise: 4;">
    <div class="file__actions">
      <a class="btn btn--primary" href={`/${lang}/demos/${project.id}/`} data-soon>
        <span>{text.demoLabel}</span>
        <Icon name="arrow" directional />
      </a>
    </div>
    {download && (
      <a class="download" href={download.file} data-soon>
        <Icon name="download" class="download__icon" />
        <span class="download__label">{text.downloadLabel}</span>
        <span class="download__kind" lang="en">
          {download.kind.toUpperCase()}
        </span>
      </a>
    )}
  </div>
</div>

<style>
  .leaf__body {
    display: grid;
    grid-template-columns: 5fr 7fr;
    grid-template-rows: auto 1fr auto;
    grid-template-areas:
      "head film"
      "act film"
      "story story";
    column-gap: clamp(40px, 5vw, 88px);
    padding-block: clamp(40px, 4.5vw, 64px) clamp(48px, 5vw, 80px);
  }
  .file__head {
    grid-area: head;
  }
  .file__film {
    grid-area: film;
  }
  /* The demo and the download sit at the foot of the first column, level with the film's bottom */
  .file__act {
    grid-area: act;
    align-self: end;
    padding-block-start: var(--s-6);
  }
  .file__act .download {
    max-inline-size: 26em;
  }

  .file__tag {
    margin: 0 0 var(--s-3);
    color: var(--c-teal);
    font: var(--fw-ui) var(--fs-kicker) / 1.4 var(--font-ui);
    letter-spacing: var(--ls-kicker);
    text-transform: uppercase;
  }
  :global(:root:lang(ar)) .file__tag {
    text-transform: none;
  }
  .file__title {
    max-inline-size: 14ch;
    margin: 0 0 var(--s-5);
    font: var(--fw-display) clamp(2.25rem, 1.4rem + 3vw, 4rem) / var(--lh-title) var(--font-display);
    letter-spacing: var(--ls-title);
    text-wrap: balance;
  }
  .file__title:focus {
    outline: none; /* receives focus by script after opening */
  }
  .file__title:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 4px;
  }

  /* Film frame: tile placeholder until the films arrive (Phase 5) */
  .film {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: var(--c-film);
  }
  .film__tiles {
    position: absolute;
    inset: 14%;
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 8px;
  }
  .film__tile {
    border-radius: 4px;
    background: var(--c-film-tile);
  }
  @keyframes tile {
    0%,
    100% {
      background: var(--c-film-tile);
    }
    40% {
      background: var(--c-film-lit);
    }
    60% {
      background: var(--c-film-tile);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(dialog[open]) .film__tile,
    :global(.leaf--page) .film__tile {
      animation: tile 4.2s ease-in-out infinite;
      animation-delay: calc(var(--t) * 0.3s);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .film__tile:nth-child(3n) {
      background: var(--c-film-lit);
    }
  }
  .film__play {
    position: relative;
    display: grid;
    place-items: center;
    inline-size: 64px;
    block-size: 64px;
    border: 0;
    border-radius: 50%;
    background: var(--c-paper);
    color: var(--c-ink);
    cursor: pointer;
    transition:
      scale var(--d-press) var(--ease-paper),
      background-color 200ms var(--ease-paper);
  }
  .film__play :global(svg) {
    inline-size: 22px;
    block-size: 22px;
  }
  .film__play:active {
    scale: 0.96;
  }
  .film__play:focus-visible {
    outline: 3px solid var(--c-signal);
    outline-offset: 3px;
  }
  @media (hover: hover) {
    .film__play:hover {
      background: var(--c-paper-hi);
    }
  }
  .file__lead {
    max-inline-size: 30em;
    margin: 0;
    color: var(--c-ink-2);
    font: var(--fw-ui) var(--fs-lead) / 1.6 var(--font-ui);
    text-wrap: pretty;
  }

  .film__summary {
    margin: var(--s-3) 0 0;
    color: var(--c-ink-muted);
    font-size: var(--fs-meta);
  }

  /* The story across the page: three columns under an ink rule, split by hairlines */
  .story {
    grid-area: story;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-block-start: clamp(48px, 5vw, 72px);
    border-block-start: 1px solid var(--c-ink);
  }
  .story__block {
    padding: var(--s-5) clamp(20px, 2.4vw, 40px) 0;
    border-inline-start: 1px solid var(--c-paper-line);
  }
  .story__block:first-child {
    padding-inline-start: 0;
    border-inline-start: 0;
  }
  .story__block:last-child {
    padding-inline-end: 0;
  }
  .story__label {
    margin: 0 0 var(--s-2);
    color: var(--c-ink-muted);
    font: var(--fw-ui) var(--fs-kicker) / 1.4 var(--font-ui);
    letter-spacing: var(--ls-kicker);
    text-transform: uppercase;
  }
  :global(:root:lang(ar)) .story__label {
    text-transform: none;
  }
  .story__text {
    max-inline-size: 34em;
    margin: 0;
    color: var(--c-ink-2);
    font: var(--fw-text) var(--fs-story) / var(--lh-story) var(--font-text);
    text-wrap: pretty;
  }

  .file__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }
  .download {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    min-block-size: var(--tap);
    margin-block-start: var(--s-4);
    padding-block: var(--s-2);
    border-block-end: 1px solid var(--c-paper-line);
    color: var(--c-ink);
    text-decoration: none;
  }
  .download :global(.download__icon) {
    transition: translate 200ms var(--ease-paper);
  }
  .download__kind {
    margin-inline-start: auto;
    color: var(--c-ink-muted);
    font-size: var(--fs-meta);
    letter-spacing: 0.08em;
  }
  @media (hover: hover) {
    .download:hover :global(.download__icon) {
      translate: 0 3px;
    }
    .download:hover .download__label {
      text-decoration: underline;
      text-underline-offset: 0.25em;
    }
  }

  @media (max-width: 899px) {
    .leaf__body {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      grid-template-areas: "head" "film" "story" "act";
      padding-block: var(--s-5) var(--s-6);
    }
    .file__film {
      margin-block-start: var(--s-5);
    }
    .story {
      grid-template-columns: 1fr;
      margin-block-start: var(--s-6);
    }
    .story__block {
      padding: var(--s-5) 0 var(--s-2);
      border-inline-start: 0;
      border-block-start: 1px solid var(--c-paper-line);
    }
    .story__block:first-child {
      border-block-start: 0;
    }
    .file__act {
      padding-block-start: var(--s-5);
    }
    .file__actions :global(.btn) {
      white-space: normal;
      line-height: 1.3;
      padding-block: var(--s-2);
    }
  }
</style>
