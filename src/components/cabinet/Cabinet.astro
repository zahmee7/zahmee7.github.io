---
// The drawer: an open box seen from the front and a little above (DESIGN.md > Drawer and folders).
// Layers, back to front: back wall, folders, depth shade, side walls, drawer front.
// It always starts closed, in its cabinet, and the visitor opens it: the drawers below it, the cabinet's
// top edge and the shadow that edge throws show only then, and pressing the front pulls it out
// (DESIGN.md > Closed drawer, pull.ts).
import { getCollection } from "astro:content";
import Folder from "./Folder.astro";
import { t, type Locale } from "../../i18n/utils";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = t(lang);
const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
---

<section
  class="container drawer"
  id="drawer"
  tabindex="-1"
  aria-label={copy.drawer.label}
  data-cabinet
  data-locked-text={copy.drawer.locked}
>
  <div class="drawer__case" aria-hidden="true">
    {Array.from({ length: 8 }, () => (
      <div class="drawer__below">
        <span class="drawer__below-label" />
        <span class="drawer__below-pull" />
      </div>
    ))}
  </div>

  <div class="drawer__cabinet">
    <div class="drawer__back" aria-hidden="true"></div>
    <ol class="drawer__stack" id="drawer-stack">
      {projects.map((entry, index) => (
        <Folder project={entry.data} lang={lang} index={index} />
      ))}
    </ol>
    <div class="drawer__depth" aria-hidden="true"></div>
    <div class="drawer__walls" aria-hidden="true"></div>
  </div>

  <div class="drawer__front">
    <span class="drawer__label" aria-hidden="true">
      {copy.drawer.label}
    </span>
    <p class="drawer__hint" data-hint>
      <span class="drawer__hint-closed">{copy.drawer.pressToOpen}</span>
      <span class="drawer__hint-pointer">{copy.drawer.hint}</span>
      <span class="drawer__hint-touch">{copy.drawer.hintTouch}</span>
    </p>
    <div class="drawer__caption" data-caption aria-hidden="true" hidden>
      <p class="drawer__caption-title" data-caption-title></p>
      <p class="drawer__caption-text" data-caption-text></p>
    </div>
    <span class="drawer__handle" aria-hidden="true"></span>
    <button
      class="drawer__opener"
      type="button"
      aria-label={copy.drawer.open}
      aria-controls="drawer-stack"
      aria-expanded="false"
      data-opener
    ></button>
  </div>

  <div class="drawer__shade" aria-hidden="true"></div>
  <div class="drawer__lip" aria-hidden="true"></div>
</section>

<script>
  import "./cabinet.ts";
</script>

<style>
  /* The drawer (DESIGN.md > Drawer and folders), design A with light, depth and metal. On desktop it
     fills the screen below the title, so its front meets the bottom edge like a drawer pulled out
     towards you (index.astro makes the page one screen tall). */
  .drawer {
    --front-h: 144px; /* the front's height, shared with the drawers below it while closed */
    --side: var(--gutter); /* the drawer is a .container: its sides are the gutter */
    position: relative;
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-block-size: 0;
    isolation: isolate;
  }
  .drawer:focus {
    outline: none;
  }

  .drawer__cabinet {
    --step: 58px; /* vertical offset between folders */
    --tab-w: clamp(230px, 21%, 270px); /* wide enough for the longest short title with Latin digits */
    --visible-front: 120px; /* the front folder shows the most paper */
    --wall-front: 30px; /* side wall thickness at the front */
    --wall-back: 8px; /* side wall thickness at the back */
    --inset-back: 52px; /* how far the back of the box sits inside the front, per side */
    --rim: 16px; /* back wall showing above the backmost folder */
    --tab-pad: 14px; /* tabs keep off the folder corners, so every tab sits on a straight edge */
    --stack-top: 78px; /* room for the first tab (56 px) and its lift */
    position: relative;
    block-size: calc(var(--stack-top) + 5 * var(--step) + var(--visible-front));
  }

  /* Warm light from the lamp above, falling on the folders and fading before every edge */
  .drawer__cabinet::after {
    content: "";
    position: absolute;
    z-index: 4;
    inset: -120px 0 0;
    pointer-events: none;
    background: radial-gradient(ellipse 48% 50% at 50% 50%, rgb(var(--c-lamp-rgb) / 0.15), transparent 100%);
    transition: opacity 900ms var(--ease-paper); /* it comes on once a closed drawer is out */
  }
  .drawer__back {
    position: absolute;
    z-index: 0;
    inset-inline: calc(var(--inset-back) - var(--wall-back) - 2px);
    inset-block: calc(var(--stack-top) - var(--rim)) 0;
    border-radius: 10px 10px 0 0;
    background: linear-gradient(180deg, var(--c-drawer-handle), var(--c-night) 70%);
    box-shadow:
      inset 0 22px 34px rgb(0 0 0 / 0.55),
      inset 0 2px 0 var(--c-drawer-edge);
  }
  .drawer__stack {
    position: absolute;
    z-index: 1;
    inset: 0;
    display: grid;
    grid-template-areas: "stack";
    margin: 0;
    padding: var(--stack-top) 0 0;
    list-style: none;
    clip-path: inset(-400px 0 18px 0); /* folder bottoms end behind the drawer front */
    overflow: clip; /* and the tall sheets never add empty scroll under the drawer */
  }
  .drawer__depth {
    position: absolute;
    z-index: 2;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, transparent 58%, rgb(var(--c-night-rgb) / 0.36) 100%);
  }
  .drawer__walls {
    position: absolute;
    z-index: 3;
    inset: 0;
    pointer-events: none;
  }
  .drawer__walls::before,
  .drawer__walls::after {
    content: "";
    position: absolute;
    inset-block: calc(var(--stack-top) - var(--rim)) 0;
    inline-size: var(--inset-back);
  }
  /* Physical sides on purpose: the box is symmetric, so RTL needs no mirroring. The inner edge catches
     the light. */
  .drawer__walls::before {
    left: 0;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--c-drawer), black 30%) 10%,
      var(--c-drawer-edge) 85%,
      color-mix(in srgb, var(--c-drawer-edge), white 18%)
    );
    clip-path: polygon(
      0 100%,
      0 calc(100% - var(--visible-front) - 18px),
      calc(100% - var(--wall-back)) 0,
      100% 0,
      var(--wall-front) 100%
    );
  }
  .drawer__walls::after {
    right: 0;
    background: linear-gradient(
      270deg,
      color-mix(in srgb, var(--c-drawer), black 30%) 10%,
      var(--c-drawer-edge) 85%,
      color-mix(in srgb, var(--c-drawer-edge), white 18%)
    );
    clip-path: polygon(
      100% 100%,
      100% calc(100% - var(--visible-front) - 18px),
      var(--wall-back) 0,
      0 0,
      calc(100% - var(--wall-front)) 100%
    );
  }

  /* While a folder is under the pointer, the others step back a little */
  @media (hover: hover) {
    .drawer:not([data-open]) .drawer__stack:has(:global(.folder:hover)) :global(.folder:not(:hover)) {
      filter: brightness(0.9) saturate(0.92);
    }
  }

  /* The front: a bevelled edge, the label in a metal holder, a metal pull */
  .drawer__front {
    position: relative;
    z-index: var(--z-drawer);
    margin-block-start: -18px; /* overlaps the clipped bottom of the stack */
    min-block-size: var(--front-h);
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--s-3);
    border-radius: 8px 8px var(--r-drawer) var(--r-drawer);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--c-drawer-edge), white 14%) 0,
      var(--c-drawer-edge) 3px,
      var(--c-drawer) 16px,
      color-mix(in srgb, var(--c-drawer), black 28%) 100%
    );
    box-shadow:
      var(--sh-drawer),
      inset 0 -8px 16px rgb(0 0 0 / 0.35);
  }
  .drawer__label {
    position: relative;
    padding: 10px 28px;
    border-radius: 3px;
    background: var(--c-paper);
    color: var(--c-ink);
    font: var(--fw-ui) 0.9375rem / 1.4 var(--font-ui);
    letter-spacing: var(--ls-kicker);
    text-transform: uppercase;
    box-shadow:
      0 0 0 5px color-mix(in srgb, var(--c-mist), var(--c-drawer) 35%),
      0 0 0 6px rgb(0 0 0 / 0.45),
      0 3px 8px 6px rgb(0 0 0 / 0.35),
      inset 0 1px 3px rgb(var(--c-ink-rgb) / 0.2);
  }
  /* two rivets hold the label */
  .drawer__label::before,
  .drawer__label::after {
    content: "";
    position: absolute;
    inset-block-start: 50%;
    inline-size: 5px;
    block-size: 5px;
    margin-block-start: -2.5px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, var(--c-paper-hi), var(--c-mist-2));
  }
  .drawer__label::before {
    inset-inline-start: -4px;
  }
  .drawer__label::after {
    inset-inline-end: -4px;
  }
  :global(:root:lang(ar)) .drawer__label {
    text-transform: none;
  }
  .drawer__handle {
    inline-size: 170px;
    block-size: 18px;
    border-radius: var(--r-pill);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--c-mist), white 30%),
      var(--c-mist-2) 55%,
      color-mix(in srgb, var(--c-mist-2), black 35%)
    );
    box-shadow:
      0 5px 10px rgb(0 0 0 / 0.55),
      inset 0 1px 0 rgb(255 255 255 / 0.7);
  }
  .drawer__hint {
    margin: 0;
    color: var(--c-mist);
    font-size: var(--fs-meta);
    text-align: center;
  }
  .drawer__hint[hidden] {
    display: none;
  }
  .drawer__hint-touch {
    display: none;
  }
  @media (hover: none) {
    .drawer__hint-pointer {
      display: none;
    }
    .drawer__hint-touch {
      display: inline;
    }
  }
  .drawer__caption {
    display: grid;
    justify-items: center;
    gap: 2px;
    min-block-size: 3.4em;
    padding-inline: var(--s-5);
    text-align: center;
  }
  .drawer__caption[hidden] {
    display: none;
  }
  .drawer__caption-title {
    margin: 0;
    color: var(--c-paper);
    font: var(--fw-display) 1.375rem / 1.45 var(--font-display);
  }
  .drawer__caption-text {
    margin: 0;
    color: var(--c-mist);
    font-size: var(--fs-meta);
  }

  /* First load of a session: the closed cabinet slides into view below the title (MOTION.md 1) */
  @keyframes drawer-out {
    from {
      opacity: 0;
      transform: translateY(56px) scale(0.965);
    }
  }
  @keyframes hint-float {
    from {
      translate: 0 0;
    }
    to {
      translate: 0 -6px;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.is-entering) .drawer {
      animation: drawer-out 850ms var(--ease-paper) 80ms backwards;
    }
    .drawer__hint {
      animation: hint-float 2.4s ease-in-out 1.9s infinite alternate;
    }
  }

  /* ---------- Closed, until the visitor opens it, on every visit (DESIGN.md > Closed drawer) ----------
     index.astro puts the classes on <html> before the first paint, and pull.ts takes them off:
     .drawer-closed   the front sits under the cabinet's top edge, the box is hidden inside
     .drawer-pulling  pressed: the front and the box travel out together (Web Animations, pull.ts)
     .drawer-lit      at the stop: the lamp comes on, the cabinet around the drawer fades away
     .drawer-cased    the cabinet around the drawer is shown; it goes once the folders have settled
     The closed layout needs no measuring: the front simply comes first. The heights stay the same, so
     the box measures the same closed and open. */
  .drawer__case,
  .drawer__shade,
  .drawer__lip,
  .drawer__opener,
  .drawer__hint-closed {
    display: none;
  }
  :global(.drawer-closed) .drawer {
    overflow: visible clip; /* the cabinet's top edge: the box comes out from under it */
  }
  :global(.drawer-closed:not(.drawer-pulling)) .drawer__front {
    order: -1;
    margin-block: 0 -18px;
  }
  :global(.drawer-closed:not(.drawer-pulling)) .drawer__cabinet {
    visibility: hidden;
  }
  :global(.drawer-closed) .drawer__cabinet {
    z-index: 1;
  }
  :global(.drawer-cased:not(.drawer-lit)) .drawer__cabinet::after {
    opacity: 0; /* the lamp is off until the drawer is out */
  }

  /* The drawers below: each a front with an empty label holder and a pull, dimmer further from the lamp.
     The first one sits behind the real front. */
  :global(.drawer-cased) .drawer__case {
    position: absolute;
    z-index: 0;
    inset-inline: var(--side);
    inset-block: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    overflow: clip;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--c-night), black 30%),
      color-mix(in srgb, var(--c-night), black 55%)
    );
    transition: opacity 360ms var(--ease-paper) 120ms;
  }
  .drawer__below {
    flex: none;
    block-size: var(--front-h);
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--s-5);
    border-radius: 6px;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--c-drawer-edge), white 8%) 0,
      var(--c-drawer-edge) 2px,
      var(--c-drawer) 14px,
      color-mix(in srgb, var(--c-drawer), black 30%) 100%
    );
    box-shadow:
      0 10px 18px rgb(0 0 0 / 0.45),
      inset 0 -8px 16px rgb(0 0 0 / 0.3);
  }
  .drawer__below:first-child {
    visibility: hidden;
  }
  .drawer__below:nth-child(2) {
    filter: brightness(0.84);
  }
  .drawer__below:nth-child(3) {
    filter: brightness(0.7);
  }
  .drawer__below:nth-child(n + 4) {
    filter: brightness(0.58);
  }
  .drawer__below-label {
    inline-size: 128px;
    block-size: 30px;
    border-radius: 3px;
    background: color-mix(in srgb, var(--c-paper), var(--c-drawer) 55%);
    box-shadow:
      0 0 0 5px color-mix(in srgb, var(--c-mist), var(--c-drawer) 45%),
      0 0 0 6px rgb(0 0 0 / 0.45),
      inset 0 1px 3px rgb(var(--c-ink-rgb) / 0.3);
  }
  .drawer__below-pull {
    inline-size: 170px;
    block-size: 18px;
    border-radius: var(--r-pill);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--c-mist), white 20%),
      var(--c-mist-2) 55%,
      color-mix(in srgb, var(--c-mist-2), black 40%)
    );
    box-shadow:
      0 5px 10px rgb(0 0 0 / 0.55),
      inset 0 1px 0 rgb(255 255 255 / 0.5);
  }

  /* The cabinet's top edge, over the top of the closed front, and the shadow it throws into the box */
  :global(.drawer-cased) .drawer__shade {
    position: absolute;
    z-index: 2;
    inset-inline: var(--side);
    inset-block-start: 0;
    display: block;
    block-size: 110px;
    pointer-events: none;
    background: linear-gradient(180deg, rgb(0 0 0 / 0.62), rgb(0 0 0 / 0.24) 40%, transparent);
    transition: opacity 800ms var(--ease-paper) 100ms;
  }
  :global(.drawer-cased) .drawer__lip {
    position: absolute;
    z-index: calc(var(--z-drawer) + 1);
    inset-inline: calc(var(--side) - 6px);
    inset-block-start: 0;
    display: block;
    block-size: 9px;
    border-radius: 0 0 3px 3px;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--c-drawer-edge), white 24%),
      var(--c-drawer-edge) 3px,
      color-mix(in srgb, var(--c-drawer), black 45%)
    );
    box-shadow: 0 4px 8px rgb(0 0 0 / 0.5);
    transition: opacity 600ms var(--ease-paper) 200ms;
  }
  :global(.drawer-lit) .drawer__case,
  :global(.drawer-lit) .drawer__shade,
  :global(.drawer-lit) .drawer__lip {
    opacity: 0;
  }

  /* The whole closed front is the button, and it says so */
  :global(.drawer-closed) .drawer__opener {
    position: absolute;
    z-index: 2;
    inset: 0;
    display: block;
    border: 0;
    border-radius: inherit;
    background: transparent;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .drawer__opener:focus-visible {
    outline: 3px solid var(--c-signal);
    outline-offset: 4px;
  }
  :global(.drawer-closed) .drawer__hint-closed {
    display: inline;
  }
  :global(.drawer-closed) .drawer__hint .drawer__hint-pointer,
  :global(.drawer-closed) .drawer__hint .drawer__hint-touch {
    display: none;
  }
  /* pressed: the front gives a little and the pull is gripped */
  .drawer__front {
    transition: scale var(--d-press) var(--ease-paper);
  }
  .drawer__handle {
    transition:
      translate var(--d-press) var(--ease-paper),
      box-shadow 200ms var(--ease-paper);
  }
  .drawer__front.is-pressed {
    scale: 0.992;
  }
  .drawer__front.is-pressed .drawer__handle {
    translate: 0 2px;
  }
  @media (hover: hover) {
    :global(.drawer-closed:not(.drawer-pulling)) .drawer__front:hover .drawer__handle {
      box-shadow:
        0 5px 10px rgb(0 0 0 / 0.55),
        inset 0 1px 0 rgb(255 255 255 / 0.7),
        0 0 18px rgb(var(--c-lamp-rgb) / 0.45);
    }
  }
  /* now and then the closed front gives a small tug, as if it wants to come out */
  @keyframes front-nudge {
    0%,
    62%,
    100% {
      translate: 0 0;
    }
    70% {
      translate: 0 7px;
    }
    78% {
      translate: 0 1px;
    }
    84% {
      translate: 0 4px;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.drawer-closed:not(.drawer-pulling)) .drawer__front {
      animation: front-nudge 3.2s var(--ease-paper) 900ms infinite;
    }
  }
  /* With reduced motion the drawer does not travel: the open drawer fades in */
  @keyframes drawer-fade-in {
    from {
      opacity: 0;
    }
  }
  :global(.drawer-faded) .drawer__cabinet {
    animation: drawer-fade-in var(--d-fade) linear;
  }

  @media (max-width: 1199px) {
    .drawer__cabinet {
      --step: 50px;
    }
  }

  /* Desktop: the drawer takes the height the masthead and the title leave, down to the bottom edge. The
     cabinet is a size container, so its parts measure the step and the front paper from its height. */
  @media (min-width: 900px) and (min-height: 620px) {
    .drawer__cabinet {
      --stack-top: 88px; /* the first tab, its lift and its focus ring stay inside the clipped stack */
      flex: 1 1 auto;
      block-size: auto;
      min-block-size: 340px;
      container-type: size;
    }
    .drawer__cabinet > * {
      --visible-front: clamp(96px, 20cqh, 170px);
      --step: clamp(46px, calc((100cqh - var(--stack-top) - var(--visible-front)) / 5), 96px);
    }
    .drawer__cabinet :global(.folder__sheet) {
      min-block-size: 100cqh;
    }
    .drawer__front {
      border-radius: 8px 8px 0 0; /* runs into the bottom edge of the screen */
    }
  }
  /* Short desktop screens (a 1366 x 768 laptop): a lower front, so the drawer still fits */
  @media (min-width: 900px) and (max-height: 820px) {
    .drawer {
      --front-h: 118px;
    }
    .drawer__front {
      gap: var(--s-2);
    }
  }

  /* The same drawer, seen closer (DESIGN.md section 9) */
  @media (max-width: 899px) {
    .drawer {
      --front-h: 124px;
      --side: 6px;
      padding-inline: var(--side);
    }
    .drawer__cabinet {
      --step: 68px;
      --tab-w: clamp(212px, 74%, 280px);
      --visible-front: 84px;
      --wall-front: 16px;
      --wall-back: 5px;
      --inset-back: 28px;
      --rim: 14px;
      --tab-pad: 10px;
      --stack-top: 88px;
    }
    .drawer__caption {
      display: none;
    }
    .drawer__front {
      border-radius: 8px 8px 0 0;
    }
    .drawer__below-label {
      inline-size: 104px;
      block-size: 26px;
    }
    .drawer__below-pull {
      inline-size: 140px;
      block-size: 16px;
    }
    :global(.drawer-cased) .drawer__lip {
      inset-inline: 0;
    }
  }
  @media (max-width: 389px) {
    .drawer__cabinet {
      --tab-w: clamp(210px, 72%, 250px);
    }
  }
</style>
