---
// The open file: a full-screen native <dialog> with a page of paper (DESIGN.md > Open file (a full page)).
// Each open project's content waits in a <template>, which the browser never renders: nothing from
// inside a project is shown until its folder is opened (owner's rule). file.ts fills and animates it,
// and moves the address bar to the project page while the file is open.
import { getCollection } from "astro:content";
import FileLeaf from "./FileLeaf.astro";
import Leaf from "./Leaf.astro";
import Icon from "../ui/Icon.astro";
import { folio, pageTitle, t, type Locale } from "../../i18n/utils";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = t(lang);
const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const total = folio(projects.length, lang);
---

<dialog class="file-dialog on-paper" id="file" data-file-sheet data-soon-text={copy.drawer.locked}>
  <Leaf lang={lang}>
    <button class="btn" type="button" data-close slot="tools">
      <Icon name="close" />
      <span>{copy.file.close}</span>
    </button>
    <div data-leaf-body></div>
    <Fragment slot="nav">
      <button class="btn" type="button" data-step="-1">
        {copy.file.prev}
      </button>
      <button class="btn" type="button" data-step="1">
        {copy.file.next}
      </button>
    </Fragment>
  </Leaf>
</dialog>

{projects
  .filter((entry) => entry.data.mvp)
  .map((entry) => (
    <template
      data-file={entry.data.id}
      data-folio-text={`${folio(entry.data.order, lang)} / ${total}`}
      data-url={`/${lang}/projects/${entry.data.id}/`}
      data-page-title={pageTitle(entry.data[lang].title, lang)}
    >
      <FileLeaf project={entry.data} lang={lang} />
    </template>
  ))}

<style>
  .file-dialog {
    color-scheme: light; /* a light scrollbar on the paper page */
    position: fixed;
    /* Physical on purpose: the page scrollbar sits on the right in both directions, so the sheet is
       anchored at the left and 100vw covers the whole window. */
    inset: auto;
    top: 0;
    left: 0;
    inline-size: 100vw;
    block-size: 100dvh;
    max-inline-size: none;
    max-block-size: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .file-dialog::backdrop {
    background: transparent;
  }
</style>
