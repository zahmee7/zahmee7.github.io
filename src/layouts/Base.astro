---
import { Font } from "astro:assets";
import "../styles/tokens.css";
import "../styles/global.css";
import { comingSoon, launched } from "../i18n/ui";
import { dir, otherLocale, t, type Locale } from "../i18n/utils";

interface Props {
  lang: Locale;
  /** Path after the locale, e.g. "projects/ndi-readiness/". Empty for the home page. */
  path?: string;
  title?: string;
  description?: string;
  /** For pages that should not be indexed and have no language twin (404). */
  noindex?: boolean;
  /** Share image name in public/og/<lang>/, made by `npm run og` (scripts/og.mjs). */
  image?: string;
  /** Project pages show the story in the first view, so its font is preloaded there. */
  story?: boolean;
  /** The site root while it says "Coming soon": its own address, and no redirect to itself. */
  root?: boolean;
}

const {
  lang,
  path = "",
  title,
  description,
  noindex = false,
  image = "home",
  story = false,
  root = false,
} = Astro.props;
const copy = t(lang);
const other = otherLocale(lang);
const pageTitle = title ?? copy.meta.title;
const pageDescription = description ?? copy.meta.description;
const canonical = new URL(root ? "/" : `/${lang}/${path}`, Astro.site);
const twin = new URL(`/${other}/${path}`, Astro.site);
const shareImage = new URL(`/og/${lang}/${image}.png`, Astro.site);
const ogLocale = { ar: "ar_SA", en: "en_US" } as const;
// While the site says "Coming soon", visitors who reach any other page go to the root (src/i18n/ui.ts)
const sendToSoon = `try {
  if (!localStorage.getItem("preview")) {
    document.documentElement.style.visibility = "hidden";
    location.replace("/");
  }
} catch (error) {
  location.replace("/");
}`;
---

<!doctype html>
<html lang={lang} dir={dir(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {comingSoon && !root && <script is:inline set:html={sendToSoon} />}
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {!launched && !noindex && <meta name="robots" content="noindex" />}
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang={lang} href={canonical} />
        <link rel="alternate" hreflang={other} href={twin} />
      </>
    )}
    <meta property="og:type" content={path ? "article" : "website"} />
    <meta property="og:site_name" content={copy.meta.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:locale:alternate" content={ogLocale[other]} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Two files preloaded on every page; the story font only where it shows in the first view (DESIGN.md section 3) -->
    <Font cssVariable="--font-thmanyah-display" preload />
    <Font cssVariable="--font-thmanyah-sans" preload />
    <Font cssVariable="--font-thmanyah-text" preload={story} />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
