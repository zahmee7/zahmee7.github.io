---
import Base from "../../layouts/Base.astro";
import { links } from "../../i18n/ui";
import { locales, otherLocale, t, type Locale } from "../../i18n/utils";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const other = otherLocale(lang);
const copy = t(lang);
---

<Base lang={lang}>
  <a class="skip" href="#main">
    {copy.skip}
  </a>

  <header class="container masthead">
    <div>
      <p class="byline__name">{copy.name}</p>
      <p class="byline__role">{copy.role}</p>
    </div>
    <nav class="masthead__nav" aria-label={copy.name}>
      <a class="btn" href={links.card}>
        {copy.nav.card}
      </a>
      <a class="btn" href={`/${other}/`} hreflang={other} lang={other} aria-label={copy.nav.langLabel}>
        {copy.nav.langShort}
      </a>
    </nav>
  </header>

  <main id="main" tabindex="-1">
    <!-- Phase 2 adds the drawer under the hero. -->
    <section class="container hero" aria-labelledby="hero-title">
      <p class="kicker">{copy.hero.kicker}</p>
      <h1 class="hero__title" id="hero-title">
        {copy.hero.h1}
      </h1>
      <p class="hero__lead">{copy.hero.lead}</p>
    </section>
  </main>
</Base>

<style>
  .masthead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding-block: var(--s-5);
  }
  .byline__name {
    margin: 0;
    font: var(--fw-display) 1.125rem / 1.3 var(--font-display);
  }
  .byline__role {
    margin: 0;
    color: var(--c-mist-2);
    font-size: var(--fs-meta);
  }
  .masthead__nav {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }
  main:focus {
    outline: none;
  }
  .hero {
    padding-block: clamp(24px, 4vw, 48px) var(--s-5);
  }
  .hero__title {
    max-inline-size: 16ch;
    margin: 0 0 var(--s-5);
    font: var(--fw-display) var(--fs-display) / var(--lh-display) var(--font-display);
    letter-spacing: var(--ls-display);
    text-wrap: balance;
  }
  .hero__lead {
    max-inline-size: 46ch;
    margin: 0;
    color: var(--c-mist);
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
    text-wrap: pretty;
  }
  @media (max-width: 899px) {
    .masthead__nav .btn {
      padding-inline: var(--s-4);
    }
  }
  @media (max-width: 389px) {
    .byline__role {
      display: none;
    }
  }
</style>
