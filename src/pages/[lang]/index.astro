---
import Base from "../../layouts/Base.astro";
import Masthead from "../../components/site/Masthead.astro";
import Hero from "../../components/site/Hero.astro";
import Cabinet from "../../components/cabinet/Cabinet.astro";
import FileSheet from "../../components/cabinet/FileSheet.astro";
import Toast from "../../components/ui/Toast.astro";
import { locales, t, type Locale } from "../../i18n/utils";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const copy = t(lang);
---

<Base lang={lang}>
  <!-- First-load entrance, once per session and never with reduced motion (MOTION.md sequence 1) -->
  <script is:inline slot="head">
    (function () {
      try {
        if (sessionStorage.getItem("entered")) return;
        sessionStorage.setItem("entered", "1");
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        var root = document.documentElement;
        root.classList.add("is-entering");
        setTimeout(function () {
          root.classList.remove("is-entering");
        }, 1900);
      } catch (error) {}
    })();
  </script>
  <a class="skip" href="#drawer">
    {copy.skip}
  </a>
  <!-- One view on desktop: the masthead and the title on top, the drawer filling the rest down to the
       bottom edge. No closing card here: the masthead's card link is enough (owner's decision). -->
  <div class="home">
    <Masthead lang={lang} />
    <main class="home__main">
      <Hero lang={lang} />
      <Cabinet lang={lang} />
    </main>
  </div>
  <FileSheet lang={lang} />
  <Toast />
</Base>

<style>
  .home {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    min-block-size: 100svh;
  }
  .home__main {
    display: flex;
    flex-direction: column;
  }
  /* Desktop: exactly one screen, so nothing is left empty under the drawer (Cabinet.astro fills it) */
  @media (min-width: 900px) and (min-height: 620px) {
    .home {
      block-size: 100svh;
    }
  }
  /* Wide screens: the masthead, the title and the drawer widen together instead of leaving night on both
     sides */
  @media (min-width: 1600px) {
    .home {
      --container: 1440px;
    }
  }
</style>
