---
import Base from "../../layouts/Base.astro";
import Masthead from "../../components/site/Masthead.astro";
import Hero from "../../components/site/Hero.astro";
import Closing from "../../components/site/Closing.astro";
import Toast from "../../components/ui/Toast.astro";
import { locales, t, type Locale } from "../../i18n/utils";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const copy = t(lang);
---

<Base lang={lang}>
  <a class="skip" href="#main">
    {copy.skip}
  </a>
  <Masthead lang={lang} />
  <main id="main" tabindex="-1">
    <Hero lang={lang} />
  </main>
  <Closing lang={lang} />
  <Toast />
</Base>

<style>
  main:focus {
    outline: none;
  }
</style>
