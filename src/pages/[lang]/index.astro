---
import Base from "../../layouts/Base.astro";
import Masthead from "../../components/site/Masthead.astro";
import Hero from "../../components/site/Hero.astro";
import Cabinet from "../../components/cabinet/Cabinet.astro";
import FileSheet from "../../components/cabinet/FileSheet.astro";
import Toast from "../../components/ui/Toast.astro";
import { locales, t, type Locale } from "../../i18n/utils";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const copy = t(lang);
---

<Base lang={lang}>
  <!-- First-load entrance, once per session and never with reduced motion (MOTION.md sequence 1) -->
  <script is:inline slot="head">
    (function () {
      try {
        if (sessionStorage.getItem("entered")) return;
        sessionStorage.setItem("entered", "1");
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        var root = document.documentElement;
        root.classList.add("is-entering");
        setTimeout(function () {
          root.classList.remove("is-entering");
        }, 1900);
      } catch (error) {}
    })();
  </script>
  <a class="skip" href="#drawer">
    {copy.skip}
  </a>
  <Masthead lang={lang} />
  <!-- No closing card here: the masthead's card link is enough on the home page (owner's decision) -->
  <main class="home">
    <Hero lang={lang} />
    <Cabinet lang={lang} />
  </main>
  <FileSheet lang={lang} />
  <Toast />
</Base>

<style>
  .home {
    padding-block-end: clamp(48px, 6vw, 96px);
  }
</style>
