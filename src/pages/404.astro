---
// GitHub Pages serves this for any unknown path, so it speaks both languages.
// DESIGN.md > Page anatomy: an empty drawer slot and one line, with a link back.
import Base from "../layouts/Base.astro";
import { t } from "../i18n/utils";

const ar = t("ar");
const en = t("en");
---

<Base lang="ar" title={`${ar.notFound.title} · ${en.notFound.title}`} noindex>
  <main class="container missing">
    <div class="missing__slot" aria-hidden="true">
      <span class="missing__folder">
        <span class="missing__tab"></span>
      </span>
    </div>
    <section class="missing__block" lang="ar" dir="rtl">
      <h1 class="missing__title">{ar.notFound.title}</h1>
      <a class="btn btn--primary" href="/ar/">
        {ar.notFound.back}
      </a>
    </section>
    <section class="missing__block" lang="en" dir="ltr">
      <p class="missing__title">{en.notFound.title}</p>
      <a class="btn" href="/en/">
        {en.notFound.back}
      </a>
    </section>
  </main>
</Base>

<style>
  .missing {
    min-block-size: 100dvh;
    display: grid;
    align-content: center;
    gap: var(--s-8);
    padding-block: var(--s-8);
  }
  /* The empty slot: a piece of the drawer where a folder should stand, drawn as a dashed outline */
  .missing__slot {
    inline-size: min(100%, 360px);
    block-size: 132px;
    padding: 44px var(--s-6) 0;
    overflow: hidden;
    border-radius: 16px 16px 0 0;
    background: linear-gradient(180deg, var(--c-drawer) 0%, var(--c-night-2) 100%);
    box-shadow: inset 0 0 0 1px var(--c-drawer-edge);
  }
  .missing__folder {
    position: relative;
    display: block;
    block-size: 140px;
    border: 2px dashed var(--c-line-3);
    border-radius: 12px;
  }
  .missing__tab {
    position: absolute;
    inset-block-end: 100%;
    inset-inline-start: var(--s-5);
    inline-size: 112px;
    block-size: 26px;
    border: 2px dashed var(--c-line-3);
    border-block-end: 0;
    border-radius: var(--r-tab);
  }
  .missing__block {
    display: grid;
    justify-items: start;
    gap: var(--s-5);
  }
  .missing__title {
    margin: 0;
    max-inline-size: 20ch;
    font: var(--fw-display) var(--fs-title) / var(--lh-title) var(--font-display);
    text-wrap: balance;
  }
  .missing__block[lang="en"] .missing__title {
    --lh-title: 1.08;
  }
</style>
