# thmanyah font files: the licence forbids uploading or hosting them on any platform.
# Keep them out of every repository. See CLAUDE.md > Fonts.
design/fonts/
src/assets/fonts/thmanyah/
*.woff2
*.otf

# Build and tooling output
node_modules/
dist/
.astro/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Local settings and secrets
.env
.env.*
.claude/settings.local.json

# OS files
.DS_Store
Thumbs.db

# Film masters are large and stay on the owner's machine (films/SCRIPTS.md).
films/*/master*
films/*/loop-master*
# Web films are made by `npm run films`. Sample films (npm run films:sample) must never reach the live site,
# so only the projects whose real films have arrived are let through, one line each.
src/assets/films/*
!src/assets/films/executive-dashboard/

# Local preview files for the demo frame, never committed
public/downloads/_preview*
